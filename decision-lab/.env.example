# Keys belong in the server process environment, never in browser JavaScript.
# Alternatively: python server.py --credentials-file /private/directory/credentials.json
# Accepted JSON keys: OPENROUTER_API_KEY, OPENAI_API_KEY, GPU_API_KEY (strings only).
# File must be current-user owned/mode 0600; its immediate directory mode 0700.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Complete self-hosted Decisions API URL; configure privately in the server environment.
# For SGLang, use the /v1/systemone endpoint accessible from the demo server.
GPU_DECISIONS_URL=
GPU_API_KEY=
GPU_MODEL_ID=Cloudflare/clef-flash
# Optional display name; defaults to Akamai GPU · Clef FP8.
GPU_MODEL_LABEL=
